  "decision_rules_priority_order": [
    {
      "rule_id": "RCC_NM_01_AS_vs_Ablation",
      "if": {
        "tumor.metastatic": false,
        "tumor.tumor_size_category": "klein",
        "any_of": [
          {
            "patient.comorbidity_level": "hoch"
          },
          {
            "patient.life_expectancy": "begrenzt"
          }
        ]
      },
      "then": {
        "primary_management_class_options": [
          "aktive_ueberwachung",
          "ablative_therapie"
        ],
        "hard_requirements": [
          "biopsie_vor_start (AS)",
          "perkutane_biopsie_vor_ablation"
        ]
      }
    },
    {
      "rule_id": "RCC_NM_02_Kurative_OP",
      "if": {
        "tumor.metastatic": false,
        "not_all_of": [
          {
            "tumor.tumor_size_category": "klein"
          },
          {
            "any_of": [
              {
                "patient.comorbidity_level": "hoch"
              },
              {
                "patient.life_expectancy": "begrenzt"
              }
            ]
          }
        ]
      },
      "then": {
        "primary_management_class": "operative_nephron_sparing_or_nephrektomie_based_on_stage_feasibility"
      }
    },
    {
      "rule_id": "RCC_NM_03_T1",
      "if": {
        "tumor.clinical_T_category": "T1"
      },
      "then": {
        "primary_management_class": "operative_nephron_sparing"
      }
    },
    {
      "rule_id": "RCC_NM_03b_T1_subcategories",
      "if": {
        "any_of": [
          {
            "tumor.clinical_T_subcategory": "T1a"
          },
          {
            "tumor.clinical_T_subcategory": "T1b"
          }
        ]
      },
      "then": {
        "primary_management_class": "operative_nephron_sparing"
      }
    },
    {
      "rule_id": "RCC_NM_04_groesser_T1",
      "if": {
        "any_of": [
          {
            "tumor.clinical_T_category": "T2"
          },
          {
            "tumor.clinical_T_category": "T3"
          },
          {
            "tumor.clinical_T_category": "T4"
          }
        ]
      },
      "then": {
        "if_nephron_sparing_technically_possible": "operative_nephron_sparing",
        "else": "operative_nephrektomie"
      }
    }
  ]
}